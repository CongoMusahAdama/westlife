# MongoDB (Atlas connection string, includes the database name at the end)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/westlife?retryWrites=true&w=majority

# Secret used to sign admin login sessions (any long random string)
JWT_SECRET=change-this-to-a-long-random-string

# Cloudinary (Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only once by `node scripts/seed.mjs` to create the first admin login.
# Not read by the deployed app — safe to remove after seeding.
ADMIN_EMAIL=admin@westlifemotors.com
ADMIN_PASSWORD=change-this-password
